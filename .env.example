# ==============================================================================
# KONFIGURASI FIREBASE (ATOMIKA)
# ==============================================================================
# Dapatkan nilai-nilai berikut dari Firebase Console:
# 1. Buka https://console.firebase.google.com/
# 2. Masuk ke Project Overview -> Project settings (ikon gerigi) -> General
# 3. Gulir ke bawah ke bagian "Your apps" -> pilih Web App (ikon </>)
# 4. Salin objek `firebaseConfig` ke variabel di bawah ini:

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# (Opsional) Supabase - fallback jika digunakan
# ==============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
