rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'className'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 40;
      allow delete: if false;
    }

    match /teachers/{teacherUid} {
      allow get: if isSignedIn() && request.auth.uid == teacherUid;
      allow list, create, update, delete: if false;
    }

    match /student_activities/{userId} {
      allow read: if isTeacher();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'className',
          'activity',
          'path',
          'progressSummary',
          'lastSeen'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'className',
          'activity',
          'path',
          'progressSummary',
          'lastSeen'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 40
        && request.resource.data.activity is string
        && request.resource.data.activity.size() <= 200
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 300
        && request.resource.data.progressSummary is string
        && request.resource.data.progressSummary.size() <= 200
        && request.resource.data.lastSeen is string;
      allow delete: if false;
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isTeacher();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'uid',
          'alias',
          'className',
          'quizTitle',
          'elapsedSeconds',
          'status',
          'activityName',
          'moduleId',
          'attemptType',
          'questionVersion',
          'answers',
          'score',
          'maxScore',
          'percent',
          'submittedAt',
          'serverReceivedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'uid',
          'alias',
          'activityName',
          'moduleId',
          'attemptType',
          'questionVersion',
          'answers',
          'score',
          'maxScore',
          'percent',
          'elapsedSeconds',
          'status',
          'serverReceivedAt'
        ])
        && request.resource.data.id == attemptId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alias is string
        && request.resource.data.moduleId is string
        && request.resource.data.activityName is string
        && request.resource.data.attemptType in ['diagnostic', 'practice']
        && request.resource.data.questionVersion is string
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 20
        && request.resource.data.score is number
        && request.resource.data.maxScore is number
        && request.resource.data.percent is number
        && request.resource.data.serverReceivedAt == request.time;
      allow update, delete: if false;
    }
  }
}
