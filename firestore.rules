rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function teacherPath(uid) {
      return /databases/$(database)/documents/teachers/$(uid);
    }

    function isValidInstitutionId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,80}$');
    }

    function hasAssignedProfile(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && exists(profilePath(uid))
        && isValidInstitutionId(get(profilePath(uid)).data.institutionId);
    }

    function isTeacherFor(institutionId) {
      return isSignedIn()
        && isValidInstitutionId(institutionId)
        && exists(teacherPath(request.auth.uid))
        && get(teacherPath(request.auth.uid)).data.institutionId == institutionId;
    }

    function matchesStudentProfile(data, uid) {
      let profile = get(profilePath(uid)).data;
      return data.uid == uid
        && data.institutionId == profile.institutionId
        && data.className == profile.className;
    }

    function validStudentActivity(data, uid) {
      return hasAssignedProfile(uid)
        && data.keys().hasOnly([
          'uid',
          'institutionId',
          'name',
          'className',
          'activity',
          'path',
          'progressSummary',
          'lastSeen'
        ])
        && data.keys().hasAll([
          'uid',
          'institutionId',
          'name',
          'className',
          'activity',
          'path',
          'progressSummary',
          'lastSeen'
        ])
        && matchesStudentProfile(data, uid)
        && data.name == get(profilePath(uid)).data.name
        && data.activity is string
        && data.activity.size() > 0
        && data.activity.size() <= 200
        && data.path is string
        && data.path.size() <= 300
        && data.progressSummary is string
        && data.progressSummary.size() <= 200
        && data.lastSeen is string
        && data.lastSeen.size() <= 40;
    }

    function validQuizAttempt(data, attemptId) {
      return hasAssignedProfile(request.auth.uid)
        && data.keys().hasOnly([
          'id',
          'uid',
          'institutionId',
          'alias',
          'className',
          'quizTitle',
          'elapsedSeconds',
          'status',
          'activityName',
          'moduleId',
          'attemptType',
          'questionVersion',
          'answers',
          'score',
          'maxScore',
          'percent',
          'submittedAt',
          'serverReceivedAt'
        ])
        && data.keys().hasAll([
          'id',
          'uid',
          'institutionId',
          'alias',
          'className',
          'elapsedSeconds',
          'status',
          'activityName',
          'moduleId',
          'attemptType',
          'questionVersion',
          'answers',
          'score',
          'maxScore',
          'percent',
          'submittedAt',
          'serverReceivedAt'
        ])
        && data.id == attemptId
        && matchesStudentProfile(data, request.auth.uid)
        && data.alias == get(profilePath(request.auth.uid)).data.name
        && data.activityName is string
        && data.activityName.size() > 0
        && data.activityName.size() <= 120
        && (!('quizTitle' in data) || (data.quizTitle is string && data.quizTitle.size() <= 120))
        && data.moduleId is string
        && data.moduleId.size() <= 40
        && data.attemptType in ['diagnostic', 'practice']
        && data.questionVersion is string
        && data.questionVersion.size() <= 40
        && data.answers is map
        && data.answers.size() <= 20
        && data.score is number
        && data.maxScore is number
        && data.maxScore > 0
        && data.maxScore <= 100
        && data.score >= 0
        && data.score <= data.maxScore
        && data.percent is number
        && data.percent >= 0
        && data.percent <= 100
        && data.elapsedSeconds is number
        && data.elapsedSeconds >= 0
        && data.elapsedSeconds <= 7200
        && data.status == 'submitted'
        && data.submittedAt is string
        && data.submittedAt.size() <= 40
        && data.serverReceivedAt == request.time;
    }

    function validAttendance(data, uid, year, month, day) {
      let jakartaTime = request.time + duration.value(7, 'h');
      return hasAssignedProfile(uid)
        && !exists(teacherPath(uid))
        && year == jakartaTime.year().toString()
        && month == jakartaTime.month().toString()
        && day == jakartaTime.day().toString()
        && data.keys().hasOnly([
          'uid',
          'institutionId',
          'name',
          'className',
          'status',
          'attendedAt'
        ])
        && data.keys().hasAll([
          'uid',
          'institutionId',
          'name',
          'className',
          'status',
          'attendedAt'
        ])
        && data.uid == uid
        && data.institutionId == get(profilePath(uid)).data.institutionId
        && data.name == get(profilePath(uid)).data.name
        && data.className == get(profilePath(uid)).data.className
        && data.status == 'hadir'
        && data.attendedAt == request.time;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'className', 'institutionId'])
        && request.resource.data.keys().hasAll(['name', 'className'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 40
        && (!('institutionId' in request.resource.data) || isValidInstitutionId(request.resource.data.institutionId));
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'className', 'institutionId'])
        && request.resource.data.keys().hasAll(['name', 'className'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'className'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 40
        && (!resource.data.keys().hasAny(['institutionId'])
          || (request.resource.data.name == resource.data.name
            && request.resource.data.className == resource.data.className));
      allow delete: if false;
    }

    match /teachers/{teacherUid} {
      allow get: if isSignedIn() && request.auth.uid == teacherUid;
      allow list, create, update, delete: if false;
    }

    match /student_activities/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId)
        || isTeacherFor(resource.data.institutionId);
      allow create, update: if request.auth.uid == userId
        && validStudentActivity(request.resource.data, userId);
      allow delete: if false;
    }

    match /quiz_attempts/{attemptId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid)
        || isTeacherFor(resource.data.institutionId);
      allow create: if isSignedIn()
        && validQuizAttempt(request.resource.data, attemptId);
      allow update, delete: if false;
    }

    match /attendance/{userId}/years/{year}/months/{month}/days/{day} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isTeacherFor(resource.data.institutionId));
      allow list: if isSignedIn()
        && ((request.auth.uid == userId && resource.data.uid == userId)
          || isTeacherFor(resource.data.institutionId));
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validAttendance(request.resource.data, userId, year, month, day);
      allow update, delete: if false;
    }

    match /essay_submissions/{submissionId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid)
        || isTeacherFor(resource.data.institutionId);
      allow create, update: if (isSignedIn() && request.auth.uid == request.resource.data.uid)
        || isTeacherFor(request.resource.data.institutionId);
      allow delete: if false;
    }
  }
}
